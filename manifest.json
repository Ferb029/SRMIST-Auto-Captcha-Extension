{
  "manifest_version": 3,
  "name": "SRMIST Auto Captcha",
  "version": "1.0",
  "description": "Fills the captcha on the SRM student portal login page. Runs offline in your browser.",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "background": { "service_worker": "background.js" },
  "permissions": ["offscreen"],
  "content_scripts": [
    {
      "matches": ["https://sp.srmist.edu.in/srmiststudentportal/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
